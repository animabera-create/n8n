    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a blog post.\n\nTopic: {{ $json.Topic }}\nKeywords: {{ $json.Keywords || 'none' }}\nTone: {{ $json.Tone }}\nLength: {{ $json.Length }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are an expert blog writer. Write a complete, engaging, well-structured blog post from the details given.\n\nRules:\n- Output ONLY the blog post in Markdown, with no commentary before or after.\n- Start with a single H1 title (# Title).\n- Follow with a short, hooking introduction.\n- Use clear H2 sections (and H3 where useful), short paragraphs, and bullet points where they help.\n- Work the given keywords in naturally; do not keyword-stuff.\n- Match the requested tone and approximate length.\n- End with a conclusion and a short call to action."
            }
          ]
        }
      },
      "id": "cc3f4b8f-825a-4f6f-bc71-ab0a0df3901b",
      "name": "Write Blog with LLM",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        256,
        -48
      ]
    },
    {
      "parameters": {
        "model": "openai/gpt-oss-20b",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        352,
        112
      ],
      "id": "e9a99cc0-058f-409c-aae9-3ea75cd90805",
      "name": "Groq Chat Model",
      "credentials": {
        "groqApi": {
          "id": "XDrrdU3CmfsinPRa",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const first = $input.first().json;\nconst raw = first.text || first.output || '';\nconst blog = String(raw)\n  .replace(/^```(?:markdown|md)?\\s*/i, '')\n  .replace(/```\\s*$/, '')\n  .trim();\n\nif (!blog) {\n  throw new Error('The model returned an empty blog post.');\n}\n\nconst titleMatch = blog.match(/^#\\s+(.+)$/m);\n\nreturn [{\n  json: {\n    title: titleMatch ? titleMatch[1].trim() : 'Your blog post',\n    blog,\n    word_count: blog.split(/\\s+/).filter(Boolean).length\n  }\n}];"
      },
      "id": "4b27a759-57ac-45e0-8633-d5b8cd82004d",
      "name": "Clean Output",
