      "position": [
        816,
        96
      ],
      "webhookId": "909131f6-236c-498f-bb79-fdadb8546d52"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst key = Object.keys(item.binary || {})[0];\nif (!key) {\n  throw new Error('No file found. Upload a PDF resume.');\n}\nreturn [{ json: item.json, binary: { data: item.binary[key] } }];"
      },
      "id": "b0446750-e62d-452d-bd19-cf31c88bd0cc",
      "name": "Pick Resume File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        928,
        -80
      ]
    },
    {
      "parameters": {
        "operation": "pdf",
        "options": {}
      },
      "id": "418d4794-f34f-40f9-b30c-c7bae6096938",
      "name": "Extract PDF Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        1040,
        80
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a resume parser. Extract the following from the resume text and return ONLY valid JSON, with no markdown and no commentary:\n\n{\n  \"name\": \"\",\n  \"email\": \"\",\n  \"skills\": [],\n  \"job_titles\": [],\n  \"companies\": [],\n  \"education\": [],\n  \"years_experience\": 0\n}\n\nRules: skills must be a flat array of short strings (e.g. \"Python\", \"SQL\"). If a field is missing, use an empty string, empty array, or 0."
            }
          ]
        }
      },
      "id": "e12914aa-2d5c-41a5-b990-bf2399ef56b2",
      "name": "Parse Resume with LLM",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        1280,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "const first = $input.first().json;\nconst raw = first.text || first.output || '';\nconst clean = String(raw).replace(/```json|```/g, '').trim();\n\nlet data;\ntry {\n  data = JSON.parse(clean);\n} catch (e) {\n  throw new Error('LLM did not return valid JSON: ' + clean.slice(0, 200));\n}\n\nconst skills = Array.isArray(data.skills) ? data.skills : [];\n\nreturn [{\n  json: {\n    candidate: data.name || '',\n    email: data.email || '',\n    years_experience: data.years_experience ?? null,\n    skills,\n    skills_list: skills.map(s => '• ' + s).join('\\n')\n  }\n}];"
      },
      "id": "e0558e99-a2d7-4b57-82e5-9da18605a382",
      "name": "Skills List",
